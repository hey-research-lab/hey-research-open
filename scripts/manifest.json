{
  "$comment": "Generic secret shapes only; this deployment's own identifiers are not published.",
  "publicName": "hey-research-open",
  "include": [
    "apps/mcp",
    "docs/AGENT_RESEARCH_RECEIPTS.md",
    "docs/ALERTS.md",
    "docs/API_CHANGELOG.md",
    "docs/DATA_SOURCES.md",
    "docs/INTEGRATIONS.md",
    "docs/MCP.md",
    "docs/PUBLIC_API.md",
    "docs/SOURCE_REGISTRY.md",
    "docs/WEBHOOKS.md",
    ":(glob)docs/screenshots/*.png",
    "packages/agent-provider-core",
    "packages/config",
    "packages/mcp-core",
    "packages/scoring",
    "packages/sdk",
    "packages/sources",
    "packages/ui"
  ],
  "copyRoot": [
    ".prettierrc.json",
    "tsconfig.base.json",
    "vitest.setup.ts"
  ],
  "rootDevDependencies": [
    "@eslint/js",
    "@types/node",
    "eslint",
    "eslint-config-prettier",
    "prettier",
    "typescript",
    "typescript-eslint",
    "vite",
    "vitest"
  ],
  "dbTypesFrom": "packages/db/src/schema/enums.ts",
  "forbidden": [
    "BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY",
    "ghp_[A-Za-z0-9]{20,}",
    "gh[osur]_[A-Za-z0-9]{30,}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "sk-[A-Za-z0-9]{20,}",
    "sk-ant-[A-Za-z0-9_-]{20,}",
    "sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}",
    "(?<![A-Z0-9])(AKIA|ASIA)[0-9A-Z]{16}(?![A-Z0-9])",
    "npm_[A-Za-z0-9]{30,}",
    "(?<![A-Za-z0-9_-])re_[A-Za-z0-9_-]{20,}",
    "\\d{8,10}:AA[\\w-]{30,}",
    "(?<![A-Za-z0-9_-])heyp?_(?=[A-Za-z0-9_-]{0,42}[0-9])[A-Za-z0-9_-]{43}(?![A-Za-z0-9_-])",
    "\\\\nMII[A-Za-z0-9+/]{40,}",
    "ory_[a-z]{2}_[A-Za-z0-9._-]{20,}",
    "CG-[A-Za-z0-9]{20,}",
    "proapi_[A-Za-z0-9]{16,}",
    "[?&](?:api[_-]?key|apikey|access[_-]?token|auth[_-]?token|token|key|secret)=(?!0x)(?![^&\\s'\"]*(?:change|replace|example|placeholder|your|dummy|redacted|xxxx|test|fake|sample|fixture|<|\\$\\{|\\{\\{))(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{20,}",
    "postgres(ql)?://(?!hey:hey@)(?![^\\s'\"]*(change|replace|example|password|<))[^\\s'\"]*:[^\\s'\"@]+@(?!localhost)",
    "(PRIVATE|ATTESTER|SIGNER|DEPLOYER)_?KEY['\"]?\\s*[:=]\\s*['\"]?0x[0-9a-fA-F]{64}",
    "(?<![A-Za-z0-9_])(AI_API_KEY|BITQUERY_[A-Z0-9_]*(KEY|TOKEN|SECRET)|COINGECKO_API_KEY|GITHUB_APP_PRIVATE_KEY|GITHUB_APP_WEBHOOK_SECRET|GITHUB_CLIENT_SECRET|GITHUB_DEPLOY_STATUS_TOKEN|GITHUB_PUBLIC_API_TOKEN|HEY_SHIP_ATTESTER_KEY|HEY_ERC8004_VALIDATOR_KEY|(HEY_)?TELEGRAM_BOT_TOKEN|INDEXNOW_KEY|RESEND_API_KEY|(RH_)?BLOCKSCOUT_[A-Z0-9_]*KEY|S3_SECRET_ACCESS_KEY|SESSION_SECRET|TELEGRAM_ACTOR_SECRET|TELEGRAM_WEBHOOK_SECRET|TWITTERAPI_IO_KEY|UNISWAP_API_KEY|WEBHOOK_MASTER_KEY|POSTGRES_PASSWORD|NPM_TOKEN)['\"]?\\s*(?:=\\s*['\"]?|:\\s*['\"]|:\\s*(?=[^\\s'\",;)}]+\\s*(?:#.*)?$))(?!process\\.|env\\.|import\\.)(?![^\\s'\"]*(change|replace|example|placeholder|your|dummy|redacted|xxxx|test|fake|sample|fixture))(?=[A-Za-z0-9_+/=.-]*[0-9])[A-Za-z0-9_+/=.-]{16,}"
  ]
}
