{
  "$comment": "Generic secret shapes only; this deployment's own identifiers are not published.",
  "publicName": "hey-research-open",
  "include": [
    "packages/config",
    "packages/scoring",
    "packages/sources",
    "packages/ui",
    "apps/mcp",
    "docs/PUBLIC_API.md",
    "docs/MCP.md",
    "docs/SOURCE_REGISTRY.md",
    "docs/DATA_SOURCES.md",
    "docs/screenshots"
  ],
  "never": [
    "apps/web",
    "apps/worker",
    "packages/domain",
    "packages/db",
    "scripts",
    "docker",
    "docs/DEPLOYMENT.md",
    "docs/RUNBOOK.md",
    "docs/DEPENDENCY_RISK.md",
    "docs/HEY_TREASURY_LEDGER.md",
    ".env.production.example",
    "docker-compose.yml",
    "docker-compose.prod.yml",
    "Dockerfile"
  ],
  "copyRoot": [
    ".npmrc",
    ".prettierrc.json",
    "tsconfig.base.json",
    "vitest.setup.ts"
  ],
  "rootDevDependencies": [
    "@eslint/js",
    "@types/node",
    "eslint",
    "eslint-config-prettier",
    "prettier",
    "typescript",
    "typescript-eslint",
    "vitest"
  ],
  "dbTypesFrom": "packages/db/src/schema/enums.ts",
  "forbidden": [
    "BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY",
    "ghp_[A-Za-z0-9]{20,}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "sk-[A-Za-z0-9]{20,}",
    "postgres(ql)?://(?!hey:hey@)(?![^\\s'\"]*(change|replace|example|password|<))[^\\s'\"]*:[^\\s'\"@]+@(?!localhost)"
  ]
}
