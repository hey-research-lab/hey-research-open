{
  "name": "@hey-research-lab/mcp",
  "version": "0.1.2",
  "mcpName": "io.github.hey-research-lab/hey-research",
  "description": "MCP server for HEY Research Lab: evidence-backed research on Robinhood Chain projects — builder activity, ships, contracts, changes and market context, each with its source. Read-only; not investment advice.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hey-research-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-research-lab/hey-research-open.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://heyresearch.xyz/docs/mcp",
  "bugs": {
    "url": "https://github.com/hey-research-lab/hey-research-open/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "robinhood-chain",
    "research",
    "blockchain-data",
    "developer-intelligence",
    "builders",
    "hey-research"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hey-research-lab/sdk": "workspace:*",
    "@hey/mcp-core": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
