[
  {
    "name": "research_answer",
    "title": "Research a Robinhood Chain project",
    "description": "Is this Robinhood Chain project still being built, what did it ship, what changed, is this contract its own? One cited answer. capability: research_project or builder_status (q: a name or $TICKER, or address, or project: a slug; a shared name lists candidates); what_changed (project or chain, 1–30 days); verify_project (address, project?); compare_builders (2–4, no winner); unknowns (every coverage state). Claims FACT/DERIVED/UNKNOWN with evidence ids; not_found is a status, not isError. Not price advice or a safety verdict.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string",
          "enum": [
            "research_project",
            "what_changed",
            "builder_status",
            "verify_project",
            "compare_builders",
            "unknowns",
            "chain_brief"
          ],
          "description": "Which answer; each takes the arguments the tool description names."
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "A project slug."
        },
        "q": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "A name or $TICKER; a shared name lists candidates, never a guess."
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 2,
          "maxItems": 4,
          "description": "compare_builders: 2 to 4 slugs."
        },
        "address": {
          "type": "string",
          "pattern": "^0[xX][a-fA-F0-9]{40}$",
          "description": "A 0x contract address on Robinhood Chain."
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "what_changed: default 7."
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "minItems": 1,
          "maxItems": 20,
          "description": "what_changed: change types to keep, e.g. build.release."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "what_changed: events shown, default 25; the total is the whole window."
        },
        "building": {
          "type": "string",
          "const": "only",
          "description": "what_changed: only events that count as building."
        },
        "detail": {
          "type": "string",
          "enum": [
            "summary",
            "full",
            "compact"
          ],
          "description": "Default summary text; full text; compact drops the capability data from the JSON."
        }
      },
      "required": [
        "capability"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "hey.agent-intelligence-response"
        },
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "capability": {
          "type": "string",
          "enum": [
            "research_project",
            "what_changed",
            "builder_status",
            "verify_project",
            "compare_builders",
            "unknowns",
            "chain_brief"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "ambiguous",
            "not_found",
            "moved",
            "invalid_request",
            "unavailable"
          ]
        },
        "answer": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": true
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "FACT",
                  "DERIVED",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": true
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": true
          }
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "capability",
        "status",
        "answer",
        "claims",
        "evidence"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "_meta": "[undefined]"
  },
  {
    "name": "find_projects",
    "title": "Find a Robinhood Chain project",
    "description": "Which Robinhood Chain project is this name, $TICKER or 0x contract? Identity only (name, ticker, contract, slug), at most eight rows; give the slug to research_answer. A full 0x address answers whether anyone is building that contract: activity status, ship records in 30 days, the last ship with its source, whether the project names it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "Name, $TICKER, slug or 0x contract; q also works."
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "hey.mcp-api-answer"
        },
        "api": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "schema",
        "api"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "_meta": "[undefined]"
  },
  {
    "name": "get_changes",
    "title": "What changed on Robinhood Chain",
    "description": "What changed on Robinhood Chain today or this week, or for one project or contract? The change ledger without market readings: releases, ships, status moves, contract deploys and upgrades, verification, sources, unlocks — one event per change with its own time and precision, when HEY first knew, and its evidence. Newest first by first arrival; for today pass detectedSince; to sync, pass after=c1.0 and keep each cursor. A retraction means HEY no longer makes that claim. Facts, never causes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 120,
          "description": "A project slug."
        },
        "contract": {
          "type": "string",
          "pattern": "^\\d{1,10}:0x[0-9a-fA-F]{40}$",
          "description": "<chainId>:<address>."
        },
        "domain": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "build",
              "contract",
              "token",
              "research",
              "lock"
            ]
          },
          "description": "Keep only these domains."
        },
        "type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "build.release",
              "build.code_activity",
              "build.ship",
              "build.status_changed",
              "build.dormant",
              "build.resumed",
              "build.accelerating",
              "build.slowing",
              "contract.deployed",
              "contract.followup_deployed",
              "contract.implementation_changed",
              "contract.source_verified",
              "contract.source_unverified",
              "contract.interface_changed",
              "contract.usage_changed",
              "contract.method_first_observed",
              "contract.method_resumed",
              "contract.v4_pool_initialized",
              "token.launch_stage_changed",
              "token.verification_changed",
              "research.published",
              "research.builder_verified",
              "research.owner_verified",
              "research.source_added",
              "research.source_unavailable",
              "research.source_restored",
              "research.source_changed",
              "research.narrative_assigned",
              "lock.unlock_due",
              "lock.observed",
              "lock.withdrawn"
            ]
          },
          "description": "Keep only these event types."
        },
        "since": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO date: events whose own time is at or after it (events with no source time are left out)."
        },
        "until": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO date: events whose own time is before it."
        },
        "detectedSince": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO instant: start a sync at the first event HEY recorded at or after it."
        },
        "after": {
          "type": "string",
          "maxLength": 64,
          "description": "Sync forward from this cursor (c1.0 is the start)."
        },
        "before": {
          "type": "string",
          "maxLength": 64,
          "description": "Browse older than this cursor."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Default 30."
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "hey.mcp-api-answer"
        },
        "api": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "schema",
        "api"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "_meta": "[undefined]"
  },
  {
    "name": "get_project_timeline",
    "title": "What a project shipped",
    "description": "What did this project ship, and when? Builds, releases, code, contract deploys, upgrades and interface changes, token verification, locks and unlocks, each with how precisely HEY knows its time. Lenses: build (default), code, onchain, locks. Paged with the before cursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A project slug, e.g. \"agentos\"."
        },
        "lens": {
          "type": "string",
          "enum": [
            "build",
            "code",
            "onchain",
            "locks"
          ],
          "description": "Default build."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Default 30."
        },
        "before": {
          "type": "string",
          "maxLength": 400,
          "description": "The cursor the previous answer gave."
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "hey.mcp-api-answer"
        },
        "api": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "schema",
        "api"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "_meta": "[undefined]"
  },
  {
    "name": "explain_fact",
    "title": "Explain a fact",
    "description": "Why does HEY say a project is Shipping, Dormant or Still Building, or show a figure? The value, FACT, DERIVED or UNKNOWN, the rule and version, the winning source, the inputs, the lineage and the evidence ids. Omit fact to list what can be explained; source.counted takes a source id. build.change explains one change (event=<ledger id>, or the latest): its stage, who reported it, any exact release↔deployment link, what HEY does not know.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A project slug, e.g. \"agentos\"."
        },
        "fact": {
          "type": "string",
          "enum": [
            "activity.status",
            "build.momentum",
            "still_building",
            "research.level",
            "token.verification",
            "source.counted",
            "build.change"
          ],
          "description": "The fact to explain; omit to list them."
        },
        "source": {
          "type": "string",
          "maxLength": 80,
          "description": "With fact=source.counted: the source id."
        },
        "event": {
          "type": "string",
          "maxLength": 240,
          "description": "With fact=build.change: a change-ledger id; omit for the latest."
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "hey.mcp-api-answer"
        },
        "api": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "schema",
        "api"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "_meta": "[undefined]"
  },
  {
    "name": "get_evidence",
    "title": "Open evidence",
    "description": "What backs this claim? Open the record a HEY answer cited by its typed id — ship:, signal:, abi:, impl:, lock:, source:, claim:, state:, narrative:, method:, sourcechange:, security:, v4hook:, v4pool:, ponsgrad: — as a receipt: what it claims, its source URL, when it happened at what precision, when HEY knew, how it is backed. A withdrawn record says so.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+:[A-Za-z0-9:._-]{1,200}$",
          "description": "A typed evidence id, e.g. \"ship:2ac87a66-…\"."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "hey.mcp-api-answer"
        },
        "api": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "schema",
        "api"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "_meta": "[undefined]"
  },
  {
    "name": "get_contract",
    "title": "Who made this contract",
    "description": "Who made this Robinhood Chain contract, and is it a known project's? Project, creation, deployer (the only account named, with a count of other tracked projects' tokens it deployed), published source code and whose code it is (template, bytecode match or its own), Sourcify's answer, proxy and implementation history, interface changes, 7 days of calls per method (counts, names withheld; a selector's signature candidate — a guess, never a name). Address (chainId default 4663) or slug for all of a project's. An unread proxy is \"not read\", never \"not a proxy\". Not a safety verdict.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0[xX][a-fA-F0-9]{40}$",
          "description": "A 0x contract address; or give slug."
        },
        "chainId": {
          "type": "integer",
          "description": "Default 4663."
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "A project slug, for all of its contracts."
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "hey.mcp-api-answer"
        },
        "api": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "schema",
        "api"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": true
    },
    "_meta": "[undefined]"
  },
