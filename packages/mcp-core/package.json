{
  "name": "@hey/mcp-core",
  "version": "0.0.0",
  "private": true,
  "description": "HEY Research's MCP tools, renderers, resources and prompts, with no transport: bundled into the stdio server (@hey-research/mcp) and mounted by the web app at /mcp.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures/api.ts",
    "./tools": "./src/tools.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hey-research/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
